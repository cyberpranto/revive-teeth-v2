{% comment %}
  <section class="sec-alt" id="faq" data-screen-label="FAQ">
    <div class="wrap">
      <div class="faq-grid">
        <div class="faq-left reveal">
          <span class="eyebrow">
            {{ section.settings.eyebrow }}
          </span>

          <h2 class="dl" style="margin-top:14px;">
            {{ section.settings.heading }}
          </h2>

          <p class="lead" style="margin-top:14px;">
            {{ section.settings.description }}
          </p>

          <div class="faq-help">
            <div class="fh-t">
              {{ section.settings.help_title }}
            </div>

            <p>
              {{ section.settings.help_text }}
            </p>

            <a
              class="link-navy"
              href="{{ section.settings.link }}"
            >
              {{ section.settings.link_text }}
            </a>
          </div>
        </div>

        <div class="faq-list reveal" data-delay="80">


          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <div class="faq-item" {{ block.shopify_attributes }}>
                <button
                  class="faq-q"
                  aria-expanded="false"
                >
                  {{ block.settings.question }}

                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </button>

                <div class="faq-a">
                  <div>
                    {{ block.settings.answer }}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endcomment %}

{% comment %}
  <section class="sec-cream faq-split" id="faq" data-screen-label="FAQ">
    <div class="faq-split-grid">
      <div class="faq-split-media">
        <img
          src="4235f1de-6739-4b20-a8c4-1cef7bfe628b"
          alt="A couple relaxing at home together, laughing and at ease"
        />
      </div>
      <div class="faq-split-content">
        <div class="faq-split-inner">
          <div class="reveal in">
            <span class="eyebrow">Questions I hear most often before someone orders.</span>
            <h2 class="dl" style="margin-top: 13px">What people want to know before they decide.</h2>
          </div>
          <div class="reveal in">
            <div class="faq-list">
              <details class="faq-item">
                <summary>
                  Should I get both or a single set?
                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </summary>
                <p>
                  Most people order both, and the reason is straightforward: when your upper and lower are produced from
                  the same impressions, the result reads as consistent and natural when you talk, laugh, or appear in a
                  photo. A single set is a perfectly good option if you only want to address one. Either way, your set is
                  built from your own impressions and nobody else's.
                </p>
              </details>
              <details class="faq-item">
                <summary>
                  What happens after I order?
                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </summary>
                <p>
                  Your impression kit ships within 48 hours, and everything you need is already inside the box, including
                  a prepaid return label so that sending your impressions back costs you nothing. Once we receive your
                  impressions, production of your set begins.
                </p>
              </details>
              <details class="faq-item">
                <summary>
                  Can I cancel after ordering?
                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </summary>
                <p>
                  Yes, you can cancel for a full refund at any point before production begins, because once we start
                  building from your impressions, your set is already being made specifically and only for you, and that
                  cannot be undone. Email support@reviveteeth.com and we will take care of everything from there.
                </p>
              </details>
              <details class="faq-item">
                <summary>
                  How long do they last?
                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </summary>
                <p>
                  How long your set holds up depends on how it is used and cared for, and I am not willing to make a
                  durability promise that might not hold true for every person, because I think that kind of claim does
                  you a disservice. What I will promise is two free remakes if something is not right when your set
                  arrives, because that is a promise we can actually stand behind.
                </p>
              </details>
              <details class="faq-item">
                <summary>
                  Can I wear them while eating?
                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </summary>
                <p>
                  Yes, for everyday soft foods. Revive Veneers are made for daily wear, including eating and drinking. For
                  hard, crunchy, sticky, or very hot foods, take them out first. They are a cosmetic appliance, not a
                  replacement for your natural bite, so they are not built for heavy chewing. Removing them for tougher
                  meals also helps them last longer.
                </p>
              </details>
              <details class="faq-item">
                <summary>
                  What if they don't feel right?
                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </summary>
                <p>
                  Then we make it right. Your set was made to your mouth, so if it is off, that is our responsibility and
                  not yours. We remake it free, up to twice, with prepaid shipping both ways, and a full refund is
                  available any time before production begins. Email support@reviveteeth.com and we handle everything from
                  there.
                </p>
              </details>
            </div>
            <p class="faq-end">
              Questions?
              <a href="mailto:support@reviveteeth.com">support@reviveteeth.com</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endcomment %}
<section class="sec-cream faq-split" id="faq" data-screen-label="FAQ">
  <div class="faq-split-grid">
    <div class="faq-split-media">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="faq-split-content">
      <div class="faq-split-inner">
        <div class="reveal in">
          {% if section.settings.eyebrow != blank %}
            <span class="eyebrow">
              {{ section.settings.eyebrow }}
            </span>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="dl" style="margin-top:13px;">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>

        <div class="reveal in">
          <div class="faq-list">
            {% for block in section.blocks %}
              <details class="faq-item" {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.question }}

                  <svg
                    class="chev"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </summary>

                {{ block.settings.answer }}
              </details>
            {% endfor %}
          </div>

          {% if section.settings.support_email != blank %}
            <p class="faq-end">
              Questions?

              <a href="mailto:{{ section.settings.support_email }}">
                {{ section.settings.support_email }}
              </a>
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Post Quiz FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "FAQ Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Questions I hear most often before someone orders."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "What people want to know before they decide."
    },

    {
      "type": "header",
      "content": "Support"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support Email",
      "default": "support@reviveteeth.com"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently Asked Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Post Quiz FAQ",
      "blocks": [
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}
