{% comment %}
  <section class="closer" id="footer" data-screen-label="Closer">
    <div class="wrap">
      <div class="sec-intro center reveal">
        <h2 class="dl">
          {{ section.settings.heading }}
        </h2>
      </div>

      <div class="closer-body reveal">
        {{ section.settings.content }}
      </div>

      <div class="reveal" style="display: flex; justify-content: center">
        <a href="{{ section.settings.button_link }}" class="btn btn-lg btn-invert scroll-buy">
          {{ section.settings.button_text }}
          {% if section.settings.button_icon != blank %}
            {{ section.settings.button_icon }}
          {% else %}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          {% endif %}
        </a>
      </div>
    </div>
  </section>
{% endcomment %}
{% comment %}
  <section class="closer" id="close" data-screen-label="Close">
    <div class="wrap">
      <div class="sec-intro center reveal in">
        <h2 class="dl">I built this for the person who stopped smiling in photos. If that is you, your set is ready.</h2>
      </div>
      <div class="reveal in" style="display: flex; justify-content: center">
        <button class="btn btn-lg btn-invert">
          ORDER MY SET
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>
{% endcomment %}

<section class="closer" id="close" data-screen-label="Close">
  <div class="wrap">
    <div class="sec-intro center reveal in">
      {% if section.settings.heading != blank %}
        <h2 class="dl">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="reveal in" style="display:flex;justify-content:center;">
      {% if section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn-lg btn-invert">
          {{ section.settings.button_text }}

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      {% else %}
        <button class="btn btn-lg btn-invert" type="button">
          {{ section.settings.button_text }}

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Post Quiz Closer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "I built this for the person who stopped smiling in photos. If that is you, your set is ready."
    },

    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ORDER MY SET"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Post Quiz Closer",
      "category": "Post Quiz"
    }
  ]
}
{% endschema %}
