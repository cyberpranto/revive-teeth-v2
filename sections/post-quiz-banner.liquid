{% assign product = section.settings.product %}

<style>
  /* Error / Highlight State */
  .terms.highlight {
    border-color: #d32f2f;
    background: rgba(211, 47, 47, 0.06);
    box-shadow: 0 0 0 3px rgba(211, 47, 47, 0.12);
    animation: termsShake 0.35s ease;
  }

  .terms-error {
    display: none;
    margin-top: 10px;
    color: #d32f2f;
    font-size: 13px;
    font-weight: 600;
  }

  @keyframes termsShake {
    0% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-4px);
    }
    40% {
      transform: translateX(4px);
    }
    60% {
      transform: translateX(-3px);
    }
    80% {
      transform: translateX(3px);
    }
    100% {
      transform: translateX(0);
    }
  }

  .gallery {
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }
  .gal-main {
    position: relative;
  }

  .gal-nav {
    position: absolute;

    top: 50%;

    transform: translateY(-50%);

    width: 44px;

    height: 44px;

    border: none;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.92);

    cursor: pointer;

    z-index: 5;

    font-size: 22px;
  }

  .gal-prev {
    left: 14px;
  }

  .gal-next {
    right: 14px;
  }


  @media screen and (max-width: 979px) {
    #mobileGallerySlot {
      margin-top: 24px;
    }
    .gal-nav {
      width: 32px;
      height: 32px;
      font-size: 16px;
    }
    .gal-prev {
      left: 0px;
    }

    .gal-next {
      right: 0px;
    }
  }

  .gal-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 15px;
    width: 100%;
    min-width: 0; /* খুব গুরুত্বপূর্ণ */
  }

  .gal-thumbs {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gal-thumbs::-webkit-scrollbar {
    display: none;
  }

  .gal-thumb {
    flex: 0 0 calc((100% - 7 * 8px) / 8);
    aspect-ratio: 1;
    padding: 0;
    border: 2px solid var(--line-2);
    border-radius: 10px;
    overflow: hidden;
    background: #000;
    transition: border-color 0.2s ease;
  }

  .gal-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gal-thumb.active {
    border-color: var(--navy);
  }
</style>

{% if product == blank %}
  <div class="page-width">
    <p>Please select a product.</p>
  </div>
{% else %}
  <section class="hero sec-cream" id="hero" data-screen-label="Hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="desktop-gallery" id="desktopGallerySlot">
          <div class="gallery reveal in">
            <div class="gal-main">
              <button class="gal-nav gal-prev" type="button">&#10094;</button>
              <img
                src="{{ product.featured_image | image_url: width: 1200 }}"
                alt="{{ product.featured_image.alt }}"
                id="mainProductImage"
                width="100"
                height="100"
              >
              <button class="gal-nav gal-next" type="button">&#10095;</button>
            </div>
            <div class="gal-strip">
              <div class="gal-thumbs" id="thumbs">
                {% for image in product.images %}
                  <button
                    class="gal-thumb {% if forloop.first %}active{% endif %}"
                    data-image="{{ image | image_url: width: 1200 }}"
                    data-alt="{{ image.alt | escape }}"
                    aria-label="{{ image.alt | escape }}"
                  >
                    <img
                      src="{{ image | image_url: width: 200 }}"
                      alt="{{ image.alt | escape }}"
                      width="100"
                      height="100"
                    >
                  </button>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        <div class="buy reveal in">
          {% if section.settings.eyebrow != blank %}
            <span class="eyebrow">
              {{ section.settings.eyebrow }}
            </span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h1 class="dxl">
              {{ section.settings.heading }}
            </h1>
          {% endif %}

          {% if section.settings.description != blank %}
            <p class="hero-sub">
              {{ section.settings.description }}
            </p>
          {% endif %}
          <span class="chip">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12l5 5 9-11"></path>
            </svg>
            {{ section.settings.badge_text }}
          </span>

          <div id="mobileGallerySlot"></div>

          <div class="cfg-label">Configuration <span>· Choose one</span></div>
          <div
            class="cfg-opts"
            role="radiogroup"
            aria-label="Configuration"
          >
            {% for variant in product.variants %}
              {% assign title = variant.title | downcase %}

              {% if title contains 'upper & lower' or title contains 'both' %}
                {% assign arch = 'both' %}
              {% elsif title contains 'upper' %}
                {% assign arch = 'upper' %}
              {% elsif title contains 'lower' %}
                {% assign arch = 'lower' %}
              {% endif %}
              <button
                class="cfg-opt {% if forloop.last %}sel{% endif %}"
                role="radio"
                data-key="{{ variant.title | handle }}"
                aria-checked="{% if forloop.last %}true{% else %}false{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-title="{{ variant.title }}"
                tabindex="0"
                data-arch="{{ arch }}"
              >
                <span class="ao-check">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12l5 5 9-11"></path>
                  </svg>
                </span>

                {% if title contains 'upper & lower' or title contains 'upper and lower' or title contains 'both' %}
                  <span class="ao-badge">Most Popular</span>

                  <svg
                    class="cfg-ico"
                    viewBox="0 0 60 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 16 C 8 0, 52 0, 56 16"></path>
                    <path d="M4 24 C 8 40, 52 40, 56 24"></path>
                  </svg>

                {% elsif title contains 'upper' %}
                  <svg
                    class="cfg-ico"
                    viewBox="0 0 60 32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 22 C 8 6, 52 6, 56 22"></path>
                    <path
                      d="M12 12 L12 19 M20 9 L20 18 M30 7.5 L30 17.5 M40 9 L40 18 M48 12 L48 19"
                      stroke-width="1.6"
                    ></path>
                  </svg>

                {% elsif title contains 'lower' %}
                  <svg
                    class="cfg-ico"
                    viewBox="0 0 60 32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 10 C 8 26, 52 26, 56 10"></path>
                    <path
                      d="M12 20 L12 13 M20 23 L20 14 M30 24.5 L30 14.5 M40 23 L40 14 M48 20 L48 13"
                      stroke-width="1.6"
                    ></path>
                  </svg>

                {% else %}
                  <svg
                    class="arch-ico"
                    viewBox="0 0 60 32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 10 C 8 26, 52 26, 56 10"></path>
                    <path
                      d="M12 20 L12 13 M20 23 L20 14 M30 24.5 L30 14.5 M40 23 L40 14 M48 20 L48 13"
                      stroke-width="1.6"
                    ></path>
                  </svg>
                {% endif %}

                <div class="ao-name">{{ variant.title }}</div>
                <div class="ao-price">
                  <s class="ao-list" id="ao-list">{{ variant.price | money_without_trailing_zeros }}</s>
                  <span class="ao-net" id="ao-net">
                    {{- variant.price | minus: 30000 | money_without_trailing_zeros -}}
                  </span>
                </div>

                {% comment %}
                  {% if title contains 'upper & lower' or title contains 'upper and lower' or title contains 'both' %}
                    <span class="save-note">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M5 12l5 5 9-11"></path>
                      </svg>
                      Save $196 vs. two single sets.
                    </span>
                  {% endif %}
                {% endcomment %}
              </button>
            {% endfor %}
          </div>
          <div class="qcard">
            <p>“{{ section.settings.quote }}”</p>
            <div class="qattr">
              <img
                src="{{ section.settings.quote_author_image | image_url }}"
                alt="{{ section.settings.quote_author_image.alt }}"
                height="100"
                width="100"
              >
              <div>
                <div class="nm">{{ section.settings.quote_author }}</div>
                <div class="rl">{{ section.settings.quote_author_designation }}</div>
              </div>
            </div>
          </div>
          <div class="price-block">
            <div class="price-row">
              <s class="p-list" id="p-list">$1,894</s> <span class="p-net" id="p-net">$1,594</span>
            </div>
            <div class="credit-line">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="8" width="18" height="4" rx="1"></rect>
                <path d="M5 12v9h14v-9"></path>
                <path d="M12 8v13"></path>
              </svg>
              {{ section.settings.credit_text }}
            </div>
            <p class="value-line">
              {{ section.settings.value_line }}
            </p>
            <p class="stock-line"><span class="stock-dot"></span>{{ section.settings.shipping_text }}</p>
          </div>
          <label class="terms" id="termsWrapper">
            <input type="checkbox" id="termsAgreement">
            <div>
              {{ section.settings.label_content }}
            </div>
          </label>
          <div id="termsError" class="terms-error">Please check the box above before continuing.</div>
          <button class="btn btn-full btn-lg" id="claimCTA">
            ORDER MY SET
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>
          <p class="guarantee">
            {{ section.settings.guareentee_text }}
          </p>

          <ul class="badge-row">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'trust_pill' %}
                  <li class="tp" {{ block.shopify_attributes }}>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12l5 5 9-11"></path>
                    </svg>

                    {{ block.settings.text }}
                  </li>
              {% endcase %}
            {% endfor %}
          </ul>

          <div class="pay-row">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'payment_method' %}
                  <span class="pay-pill" {{ block.shopify_attributes }}>
                    {{ block.settings.title }}
                  </span>
              {% endcase %}
            {% endfor %}

            <span class="pay-secure">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
              </svg>
              {{ section.settings.secure_text }}
            </span>
          </div>
          <div class="drops">
            <details class="drop">
              <summary>
                {{ section.settings.kit_title }}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div class="drop-inner">
                <div class="kit-list">
                  {% for block in section.blocks %}
                    {% if block.type == 'kit_item' %}
                      <div class="kit-row" {{ block.shopify_attributes }}>
                        <span class="kit-ico">
                          {{ block.settings.icon }}
                        </span>
                        <div>
                          <h5>
                            {{ block.settings.heading }}
                          </h5>

                          <p>
                            {{ block.settings.text }}
                          </p>
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
                <div class="drop-note">
                  {{ section.settings.kit_note }}
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}


