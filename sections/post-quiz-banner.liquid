{% assign product = section.settings.product %}

{% if product == blank %}
  <div class="page-width">
    <p>Please select a product.</p>
  </div>
{% else %}
  <section class="hero sec-cream" id="hero" data-screen-label="Hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="gallery reveal in">
          <div class="gal-main">
            <img
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt }}"
              width="100"
              height="100"
            >
          </div>
          <div class="gal-thumbs" id="thumbs">
            {% for image in product.images %}
              <button
                class="gal-thumb  {% if forloop.first %}active{% endif %}"
                data-image="{{ image | image_url: width: 1200 }}"
                data-alt="{{ image.alt | escape }}"
                aria-label="{{ image.alt | escape }}"
              >
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | escape }}"
                  width="100"
                  height="100"
                >
              </button>
            {% endfor %}
          </div>
        </div>
        <div class="buy reveal in">
          {% if section.settings.eyebrow != blank %}
            <span class="eyebrow">
              {{ section.settings.eyebrow }}
            </span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h1 class="dxl">
              {{ section.settings.heading }}
            </h1>
          {% endif %}

          {% if section.settings.description != blank %}
            <p class="hero-sub">
              {{ section.settings.description }}
            </p>
          {% endif %}
          <span class="chip">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12l5 5 9-11"></path>
            </svg>
            {{ section.settings.badge_text }}
          </span>
          <div class="cfg-label">Configuration <span>· Choose one</span></div>
          {% comment %}
            <div class="cfg-opts" role="radiogroup" aria-label="Configuration">
              <button class="cfg-opt" role="radio" aria-checked="false">
                <svg
                  class="cfg-ico"
                  viewBox="0 0 60 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 22 C 8 6, 52 6, 56 22"></path>
                  <path
                    d="M12 12 L12 19 M20 9 L20 18 M30 7.5 L30 17.5 M40 9 L40 18 M48 12 L48 19"
                    stroke-width="1.6"
                  ></path>
                </svg>
                <div class="ao-name">Upper</div>
                <div class="ao-price"><s class="ao-list">$1,195</s><span class="ao-net">$895</span></div>
              </button>
              <button class="cfg-opt" role="radio" aria-checked="false">
                <svg
                  class="cfg-ico"
                  viewBox="0 0 60 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 10 C 8 26, 52 26, 56 10"></path>
                  <path
                    d="M12 20 L12 13 M20 23 L20 14 M30 24.5 L30 14.5 M40 23 L40 14 M48 20 L48 13"
                    stroke-width="1.6"
                  ></path>
                </svg>
                <div class="ao-name">Lower</div>
                <div class="ao-price"><s class="ao-list">$1,195</s><span class="ao-net">$895</span></div>
              </button>
              <button class="cfg-opt sel" role="radio" aria-checked="true">
                <span class="ao-badge">MOST POPULAR</span>
                <span class="ao-check">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12l5 5 9-11"></path>
                  </svg>
                </span>
                <svg
                  class="cfg-ico"
                  viewBox="0 0 60 40"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 16 C 8 0, 52 0, 56 16"></path>
                  <path d="M4 24 C 8 40, 52 40, 56 24"></path>
                </svg>
                <div class="ao-name">Upper &amp; Lower</div>
                <div class="ao-price"><s class="ao-list">$1,894</s><span class="ao-net">$1,594</span></div>
                <span class="save-note">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12l5 5 9-11"></path>
                  </svg>
                  Save $196 vs. two single sets.
                </span>
              </button>
            </div>
          {% endcomment %}
          <div
            class="cfg-opts"
            role="radiogroup"
            aria-label="Configuration"
          >
            {% for variant in product.variants %}
              {% assign title = variant.title | downcase %}

              {% if title contains 'upper & lower' or title contains 'both' %}
                {% assign arch = 'both' %}
              {% elsif title contains 'upper' %}
                {% assign arch = 'upper' %}
              {% elsif title contains 'lower' %}
                {% assign arch = 'lower' %}
              {% endif %}
              <button
                class="cfg-opt {% if forloop.last %}sel{% endif %}"
                role="radio"
                data-key="{{ variant.title | handle }}"
                aria-checked="{% if forloop.last %}true{% else %}false{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-title="{{ variant.title }}"
                tabindex="0"
                data-arch="{{ arch }}"
              >
                <span class="ao-check">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12l5 5 9-11"></path>
                  </svg>
                </span>

                {% if title contains 'upper & lower' or title contains 'upper and lower' or title contains 'both' %}
                  <span class="ao-badge">Most Popular</span>

                  <svg
                    class="cfg-ico"
                    viewBox="0 0 60 40"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 16 C 8 0, 52 0, 56 16"></path>
                    <path d="M4 24 C 8 40, 52 40, 56 24"></path>
                  </svg>

                {% elsif title contains 'upper' %}
                  <svg
                    class="cfg-ico"
                    viewBox="0 0 60 32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 22 C 8 6, 52 6, 56 22"></path>
                    <path
                      d="M12 12 L12 19 M20 9 L20 18 M30 7.5 L30 17.5 M40 9 L40 18 M48 12 L48 19"
                      stroke-width="1.6"
                    ></path>
                  </svg>

                {% elsif title contains 'lower' %}
                  <svg
                    class="cfg-ico"
                    viewBox="0 0 60 32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 10 C 8 26, 52 26, 56 10"></path>
                    <path
                      d="M12 20 L12 13 M20 23 L20 14 M30 24.5 L30 14.5 M40 23 L40 14 M48 20 L48 13"
                      stroke-width="1.6"
                    ></path>
                  </svg>

                {% else %}
                  <svg
                    class="arch-ico"
                    viewBox="0 0 60 32"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 10 C 8 26, 52 26, 56 10"></path>
                    <path
                      d="M12 20 L12 13 M20 23 L20 14 M30 24.5 L30 14.5 M40 23 L40 14 M48 20 L48 13"
                      stroke-width="1.6"
                    ></path>
                  </svg>
                {% endif %}

                <div class="ao-name">{{ variant.title }}</div>
                <div class="ao-price">
                  <s class="ao-list">{{ variant.price | money_without_trailing_zeros }}</s>
                  <span class="ao-net">{{- variant.price | minus: 30000 | money_without_trailing_zeros }}</span>
                </div>

                {% if title contains 'upper & lower' or title contains 'upper and lower' or title contains 'both' %}
                  <span class="save-note">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12l5 5 9-11"></path>
                    </svg>
                    Save $196 vs. two single sets.
                  </span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
          <div class="qcard">
            <p>“{{ section.settings.quote }}”</p>
            <div class="qattr">
              <img
                src="{{ section.settings.quote_author_image }}"
                alt="{{ section.settings.quote_author_image.alt }}"
                height="100"
                width="100"
              >
              <div>
                <div class="nm">{{ section.settings.quote_author }}</div>
                <div class="rl">{{ section.settings.quote_author_designation }}</div>
              </div>
            </div>
          </div>
          <div class="price-block">
            <div class="price-row"><s class="p-list">$1,894</s> <span class="p-net">$1,594</span></div>
            <div class="credit-line">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="8" width="18" height="4" rx="1"></rect>
                <path d="M5 12v9h14v-9"></path>
                <path d="M12 8v13"></path>
              </svg>
              {{ section.settings.credit_text }}
            </div>
            <p class="value-line">
              {{ section.settings.value_line }}
            </p>
            <p class="stock-line"><span class="stock-dot"></span>{{ section.settings.shipping_text }}</p>
          </div>
          <label class="terms">
            <input type="checkbox" />
            <span
              >I have read and agree to the <a class="link-navy" href="#">Terms of Service</a>, including the Binding
              Arbitration Agreement and Class Action Waiver in Section 15, the
              <a class="link-navy" href="#">Privacy Policy</a>, and the
              <a class="link-navy" href="#">Refund, Remake &amp; Returns Policy</a>.</span
            >
          </label>
          <button class="btn btn-full btn-lg">
            ORDER MY SET
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </button>
          <p class="guarantee">
            {{ section.settings.guareentee_text }}
          </p>
          <ul class="badge-row">
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12l5 5 9-11"></path>
              </svg>
              Two Free Remakes
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12l5 5 9-11"></path>
              </svg>
              Dentist-Designed
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12l5 5 9-11"></path>
              </svg>
              Free Shipping Both Ways
            </li>
            <li>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12l5 5 9-11"></path>
              </svg>
              Designed in the USA
            </li>
          </ul>

          <ul class="badge-row">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'trust_pill' %}
                  <li class="tp" {{ block.shopify_attributes }}>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12l5 5 9-11"></path>
                    </svg>

                    {{ block.settings.text }}
                  </li>
              {% endcase %}
            {% endfor %}
          </ul>

          <div class="pay-row">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'payment_method' %}
                  <span class="pay-pill" {{ block.shopify_attributes }}>
                    {{ block.settings.title }}
                  </span>
              {% endcase %}
            {% endfor %}

            <span class="pay-secure">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
              </svg>
              {{ section.settings.secure_text }}
            </span>
          </div>
          <div class="pay-row">
            <span class="pay-pill">VISA</span>
            <span class="pay-pill">Mastercard</span>
            <span class="pay-pill">AMEX</span>
            <span class="pay-pill">Apple Pay</span>
            <span class="pay-secure">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
              </svg>
              Secure checkout</span
            >
          </div>
          <div class="drops">
            <details class="drop">
              <summary>
                {{ section.settings.kit_title }}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div class="drop-inner">
                <div class="kit-list">
                  {% for block in section.blocks %}
                    {% if block.type == 'kit_item' %}
                      <div class="kit-row" {{ block.shopify_attributes }}>
                        <span class="kit-ico">
                          {{ block.settings.icon }}
                        </span>
                        <div>
                          <h5>
                            {{ block.settings.heading }}
                          </h5>

                          <p>
                            {{ block.settings.text }}
                          </p>
                        </div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
                <div class="drop-note">
                  {{ section.settings.kit_note }}
                </div>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  {% comment %}
    <script>
        (function () {
        var hasSession = !!localStorage.getItem('quiz_email');

        if (!hasSession) {
          window.location.replace('/pages/quiz?from=offer');
        }
      })();
    </script>
  {% endcomment %}
{% endif %}

{% schema %}
{
  "name": "Post Quiz Banner",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
