<div class="quiz-wrapper">
  .
  <div class="quiz-wrapper-container">
    <p class="page-heading">Answer 3 quick questions to unlock your $300 Smile Design credit</p>
    <div
      class="octane-ai-quiz "
      data-quiz-id="CLqI8ayPPOEs7tTY"
      data-embed-type="fullpage"
      data-mobile-height="420px"
      data-desktop-height="420px"
      style="min-height:420px"
    >
      <div style="position: relative; width: 100%; height: 100%; min-height: 200px;" id="octane-loading-spinner-outer">
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center">
          <div style="width: 50px; height: 50px;">
            <img
              style="border: none"
              id="octane-loading-spinner-img"
              src="data:image/svg+xml;base64,"
              alt="Loading..."
              width="100%"
              height="100%"
            >
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://app.octaneai.com/kz8jedy05hhkuuz3/quiz.js" defer></script>
  <script>
    document.addEventListener('octane.quiz.completed', function (event) {
      console.log('Quiz completed!', event.detail);

      const email = event.detail?.email || event.detail?.contact?.email || event.detail?.answers?.email;

      const arch = event.detail?.arch_choice || event.detail?.answers?.arch_choice || event.detail?.arch;

      const teethCount = event.detail?.teeth_count || event.detail?.answers?.teeth_count;

      if (!email) {
        console.error('Quiz Session Error: email not found in event.detail', event.detail);
        return;
      }

      // Save quiz data
      localStorage.setItem('quiz_email', email);

      if (arch) {
        localStorage.setItem('quiz_arch', arch);
      }

      // Redirect only for eligible users
      if (teethCount === 'all' || teethCount === 'few_missing') {
        window.location.href = `https://reviveteeth.com/pages/offer?set=${encodeURIComponent(arch)}`;
      } else {
        console.log(`No redirect. teeth_count = ${teethCount}`);
      }
    });
  </script>
</div>
