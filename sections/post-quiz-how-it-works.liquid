<section class="sec-alt" id="how" data-screen-label="How">
  <div class="wrap">
    <div class="sec-intro center reveal in">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="dl">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="lead">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="hiw-grid">
      {% for block in section.blocks %}
        <div class="hiw-card reveal in" {{ block.shopify_attributes }}>
          <div class="hiw-media">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image_alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="hiw-body">
            {% if block.settings.step != blank %}
              <span class="step-eyebrow">
                {{ block.settings.step }}
              </span>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Post Quiz How It Works",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps, and every one of them happens at home."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "I wanted this to be simple enough to do at your kitchen table, because the last thing you need is another appointment, another drive to an office, or another person standing over you telling you what your teeth are supposed to look like."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text",
          "default": "Step image"
        },
        {
          "type": "text",
          "id": "step",
          "label": "Step Label",
          "default": "Step 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose your set."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe this step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Post Quiz How It Works",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
